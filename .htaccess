# Ultramedia en ultramedia.com.co (hosting compartido Namecheap, LiteSpeed).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# siempre la dirección segura y sin www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# nada de archivos de trabajo ni claves a la vista
<FilesMatch "\.(key|md|mjs|json|txt|log)$">
  Require all denied
</FilesMatch>
<Files "robots.txt">
  Require all granted
</Files>

<IfModule mod_mime.c>
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType application/javascript .js
  AddCharset utf-8 .html .css .js .txt .xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml text/plain application/xml
</IfModule>

# imágenes y fuentes en caché un mes; css/js llevan ?v= cuando cambian
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
